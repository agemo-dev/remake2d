--- /dev/null	2026-10-01 19:26:42.485373486 +0000
+++ RMK2D/tools/check_headers.sh	2026-10-02 07:07:12.920258217 +0000
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Pre-push check, no SDL needed. Run from the repo root:  tools/check_headers.sh [c++ compiler]
+#  1) every public header must compile on its own (catches missing <cmath>, <bitset>...)
+#  2) public headers must not include SDL (remake2d keeps SDL private)
+#  3) no .cpp may instantiate a type holding an incomplete SDL type (see below)
+# Tip: run it with g++ AND clang++ (libstdc++ vs libc++ include different things transitively).
+CXX=${1:-g++}
+# Internal headers that are only meant to be included from another header
+SKIP='remake2d/config/version.hpp|remake2d/private/esignal.hpp'
+fail=0
+tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
+
+for h in $(cd include && find remake2d -name '*.hpp' | sort | grep -Ev "$SKIP"); do
+    echo "#include <$h>" > "$tmp/t.cpp"
+    out=$($CXX -std=c++20 -fsyntax-only -Iinclude -Isrc -Iassets -Iexternal \
+          -Iexternal/remake2d -Iexternal/remake2d/box2d/include "$tmp/t.cpp" 2>&1 | grep -m2 "error")
+    if [ -n "$out" ]; then echo "NOT SELF-CONTAINED: $h"; echo "$out" | cut -c1-200; fail=1; fi
+done
+
+# 3) .cpp files: catches std::vector<SDL_X>/unique_ptr<SDL_X> members whose ctor/dtor is
+#    defined inline in a header (incomplete type) in files that never include SDL.
+#    Files that include SDL themselves stop at that include (no SDL in this check): ignored.
+for f in $(find src -name '*.cpp' | sort); do
+    out=$($CXX -std=c++20 -fsyntax-only -Iinclude -Isrc -Iassets -Iexternal \
+          -Iexternal/remake2d -Iexternal/remake2d/box2d/include "$f" 2>&1 \
+          | grep -E "incomplete type|must be a complete class|is destructible" | head -2)
+    if [ -n "$out" ]; then echo "INCOMPLETE SDL TYPE USED IN: $f"; echo "$out" | cut -c1-200; fail=1; fi
+done
+
+leaks=$(grep -rnE '#include *[<"](SDL2?/|SDL|SDL_)' include src/remake2d/template 2>/dev/null)
+if [ -n "$leaks" ]; then echo "SDL LEAK in public headers:"; echo "$leaks"; fail=1; fi
+
+[ $fail -eq 0 ] && echo "OK: headers are self-contained and SDL-free"
+exit $fail
